---
import { formatDate, guideUrl, type Guide } from '../lib/content';

interface Props {
  guide: Guide;
  gameTitle?: string;
  headingLevel?: 2 | 3;
}

const { guide, gameTitle, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const date = guide.data.updatedAt ?? guide.data.publishedAt;
---

<article class="guide-card">
  <div class="meta">
    {guide.data.draft && <span class="draft-label">下書き</span>}
    {gameTitle && <span class="game-title">{gameTitle}</span>}
    <span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {guide.data.updatedAt ? ' 更新' : ' 公開'}
    </span>
  </div>
  <div class="title-row">
    <div>
      <Heading class="title">
        <a href={guideUrl(guide)}>{guide.data.title}</a>
      </Heading>
      <p>{guide.data.description}</p>
    </div>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </div>
</article>

<style>
  .guide-card {
    padding-block: 1.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block-end: 0.6rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .game-title {
    color: var(--accent);
    font-weight: 600;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    font-size: 1.1rem;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  p {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .arrow {
    flex-shrink: 0;
    font-size: 1.3rem;
    color: var(--accent);
  }
</style>
