---
import { site } from '../site';
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  titleContext?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  titleContext,
  description = site.description,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
const pageTitle = [title, titleContext, site.title].filter(Boolean).join(' | ');
const blockIndexing = noindex || !__SITE_INDEXABLE__;
const canonical = blockIndexing
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
const structuredData = canonical
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': isHome
            ? 'WebSite'
            : type === 'article'
              ? 'BlogPosting'
              : 'CollectionPage',
          name: isHome ? site.title : title,
          ...(type === 'article' && {
            headline: title,
            datePublished: publishedAt?.toISOString(),
            dateModified: (updatedAt ?? publishedAt)?.toISOString(),
            mainEntityOfPage: canonical.href,
          }),
          description,
          url: canonical.href,
          inLanguage: 'ja',
        },
        ...(breadcrumbs.length > 1
          ? [
              {
                '@type': 'BreadcrumbList',
                itemListElement: breadcrumbs.map(({ name, path }, index) => ({
                  '@type': 'ListItem',
                  position: index + 1,
                  name,
                  item: new URL(path, Astro.site).href,
                })),
              },
            ]
          : []),
      ],
    }
  : undefined;
// Keep content containing </script> from ending the JSON-LD script element.
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={interFontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {blockIndexing && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    {publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary" />
    {structuredDataJson && (
      <script type="application/ld+json" set:html={structuredDataJson} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      本文へスキップ
    </a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label={`${site.title} トップページ`}>
        <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#2b2b2b" />
          <path d="M16 18h32v8H24v12h16v-4h-8v-8h16v20H16z" fill="#dbe2eb" />
        </svg>
        {isHome ? <h1>{site.title}</h1> : <span>{site.title}</span>}
      </a>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    z-index: 1;
    padding: 0.5rem 1rem;
    background: var(--highlight);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-block-end: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font: 500 1rem / 1.4 var(--font-sans);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .brand h1 {
    font: inherit;
    letter-spacing: inherit;
  }
</style>
