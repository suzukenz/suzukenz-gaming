{
  "name": "suzukenz-gaming",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check && pnpm test",
    "cf:preview": "pnpm build && wrangler dev",
    "deploy": "pnpm verify && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0",
    "yaml": "^2.9.1"
  }
}
